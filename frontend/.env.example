# ============================================================
# GronLiv Frontend — Environment Variables Template (.env.example)
# Copy this file to .env.local for local dev or set in Vercel/hosting dashboard.
# NEVER include private API keys or database credentials in client variables.
# ============================================================

# Backend API Base URL
NEXT_PUBLIC_API_URL=https://api.gronliv.in

# Site Base URL (Used for canonical URLs, Open Graph, Sitemap)
NEXT_PUBLIC_SITE_URL=https://gronliv.in

# Public Business Support Channels
NEXT_PUBLIC_WHATSAPP_NUMBER=919000000000
NEXT_PUBLIC_CONTACT_EMAIL=hello@gronliv.com

# Public Social Media Handles
NEXT_PUBLIC_INSTAGRAM_HANDLE=gronliv
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/gronliv
