# ============================================================
# Vitaura Nutrition Frontend — Environment Variables Template (.env.example)
# Copy this file to .env.local for local dev or set in Vercel/hosting dashboard.
# NEVER include private API keys or database credentials in client variables.
# ============================================================

# Backend API Base URL
NEXT_PUBLIC_VITAURA_API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Site Base URL (Used for canonical URLs, Open Graph, Sitemap)
NEXT_PUBLIC_VITAURA_SITE_URL=https://vitauranutrition.com
NEXT_PUBLIC_SITE_URL=https://vitauranutrition.com

# Public Business Support Channels
NEXT_PUBLIC_VITAURA_WHATSAPP_NUMBER=919000000000
NEXT_PUBLIC_WHATSAPP_NUMBER=919000000000
NEXT_PUBLIC_VITAURA_CONTACT_EMAIL=hello@vitauranutrition.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@vitauranutrition.com

# Public Social Media Handles
NEXT_PUBLIC_VITAURA_INSTAGRAM_HANDLE=vitauranutrition
NEXT_PUBLIC_INSTAGRAM_HANDLE=vitauranutrition
NEXT_PUBLIC_VITAURA_INSTAGRAM_URL=https://instagram.com/vitauranutrition
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/vitauranutrition
