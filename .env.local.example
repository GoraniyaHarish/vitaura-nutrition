# =============================================================
# VITAURA NUTRITION — ENVIRONMENT VARIABLES
# =============================================================
# Copy this file to frontend/.env.local for frontend
# Copy to backend/.env or set as system env vars for backend
#
# NEVER commit real values to version control.
# NEVER hardcode these values in source code.
# =============================================================

# ---- FRONTEND (Next.js) ------------------------------------
# All frontend env vars must be prefixed NEXT_PUBLIC_ to be
# accessible in browser. Server-only vars have no prefix.

# Backend API URL
NEXT_PUBLIC_VITAURA_API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# WhatsApp Support Number (format: country code + number, no +)
NEXT_PUBLIC_VITAURA_WHATSAPP_NUMBER=919000000000
NEXT_PUBLIC_WHATSAPP_NUMBER=919000000000

# Brand social media
NEXT_PUBLIC_VITAURA_INSTAGRAM_HANDLE=vitauranutrition
NEXT_PUBLIC_VITAURA_INSTAGRAM_URL=https://instagram.com/vitauranutrition
NEXT_PUBLIC_INSTAGRAM_HANDLE=vitauranutrition
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/vitauranutrition

# Contact email shown on website
NEXT_PUBLIC_VITAURA_CONTACT_EMAIL=concierge@vitauranutrition.com
NEXT_PUBLIC_CONTACT_EMAIL=concierge@vitauranutrition.com

# Site URL (used for OG tags, sitemap)
NEXT_PUBLIC_SITE_URL=https://vitauranutrition.com

# Google Analytics (optional, leave blank to disable)
NEXT_PUBLIC_GA_ID=

# ---- BACKEND (Spring Boot) ---------------------------------

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vitaura_db
DB_USERNAME=vitaura_user
DB_PASSWORD=CHANGE_ME_BEFORE_PRODUCTION

# JWT
JWT_SECRET=CHANGE_ME_MINIMUM_256_BIT_SECRET_KEY_REQUIRED
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM=concierge@vitauranutrition.com

# WhatsApp Business API (future)
WHATSAPP_API_TOKEN=CHANGE_ME
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME

# Razorpay (use test keys during development)
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME

# PhonePe (use test credentials during development)
PHONEPE_MERCHANT_ID=CHANGE_ME
PHONEPE_SALT_KEY=CHANGE_ME
PHONEPE_SALT_INDEX=1

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_CONTACT_PER_HOUR=10

# Admin (change before ANY deployment)
ADMIN_INITIAL_EMAIL=admin@vitauranutrition.com
ADMIN_INITIAL_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- PRODUCTION NOTES -------------------------------------
# Before going live:
# 1. Set all CHANGE_ME values to real secrets
# 2. Use a secrets manager (AWS Secrets Manager / Vault)
# 3. Rotate JWT_SECRET
# 4. Use production SMTP credentials
# 5. Enable Razorpay/PhonePe LIVE mode
# 6. Restrict CORS_ALLOWED_ORIGINS to production domain only
# 7. Change ADMIN_INITIAL_PASSWORD immediately after first login
# =============================================================
