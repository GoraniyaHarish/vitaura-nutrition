# ============================================================
# Vitaura Nutrition Backend — Environment Variables Template (.env.example)
# Copy this file to .env and replace placeholder values.
# NEVER commit the actual .env file or real secrets to Git.
# ============================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vitaura_db
DB_USERNAME=vitaura_user
DB_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_PASSWORD

# Security & JWT Configuration
# Generate 256-bit key: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_STRONG_256_BIT_SECRET_KEY
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# CORS Allowed Origins (Comma-separated for multiple)
CORS_ALLOWED_ORIGINS=https://vitauranutrition.com,https://www.vitauranutrition.com,http://localhost:3000

# Mail Configuration (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=concierge@vitauranutrition.com
MAIL_PASSWORD=REPLACE_WITH_APP_PASSWORD

# Payment Gateways (Razorpay / PhonePe)
RAZORPAY_KEY_ID=rzp_live_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_SECRET
PHONEPE_MERCHANT_ID=MERCHANT_ID_REPLACE_ME
PHONEPE_SALT_KEY=REPLACE_WITH_SALT_KEY
PHONEPE_SALT_INDEX=1

# Application Contact & Support
CONTACT_RECIPIENT_EMAIL=concierge@vitauranutrition.com
NEXT_PUBLIC_WHATSAPP_NUMBER=919000000000
